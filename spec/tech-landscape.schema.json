{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tech-landscape.schema.json",
  "type": "object",
  "required": ["technologies", "adjacentTechnologies", "domainPatterns", "collaborationNorms", "aiAssistedWork", "timelineChecks", "researchNotes"],
  "properties": {
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purpose", "strengths", "currentGaps", "typicalVersionsByEra"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "purpose": { "type": "string", "minLength": 10 },
          "strengths": { "type": "array", "items": { "type": "string" } },
          "currentGaps": { "type": "array", "items": { "type": "string" } },
          "commonArchitectures": { "type": "array", "items": { "type": "string" } },
          "typicalVersionsByEra": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["era", "versions", "notes"],
              "properties": {
                "era": { "type": "string" },
                "versions": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "adjacentTechnologies": {
      "type": "array",
      "minItems": 1,
      "description": "Supporting tools not always named in the JD but commonly required to make the named stack work.",
      "items": {
        "type": "object",
        "required": ["name", "supports", "whyNeeded", "whereItShowsUp"],
        "properties": {
          "name": { "type": "string" },
          "supports": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "whyNeeded": { "type": "string", "minLength": 10 },
          "whereItShowsUp": { "type": "string", "minLength": 10 },
          "typicalVersionsByEra": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["era", "versions", "notes"],
              "properties": {
                "era": { "type": "string" },
                "versions": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "domainPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "summary", "storyHooks"],
        "properties": {
          "topic": { "type": "string" },
          "summary": { "type": "string", "minLength": 10 },
          "storyHooks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "collaborationNorms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partners", "howTeamsInteract", "artifacts"],
        "properties": {
          "partners": { "type": "array", "items": { "type": "string" } },
          "howTeamsInteract": { "type": "string", "minLength": 10 },
          "artifacts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "aiAssistedWork": {
      "type": "object",
      "required": ["appliesFrom", "tools", "teamSharingNorms", "mentionGuidance"],
      "properties": {
        "appliesFrom": { "type": "string", "description": "ISO year or year-month when AI coding assistants became normal to mention, typically 2024." },
        "tools": { "type": "array", "items": { "type": "string" } },
        "teamSharingNorms": { "type": "array", "items": { "type": "string" } },
        "mentionGuidance": { "type": "string", "minLength": 10 },
        "timelineNotes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timelineChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["technology", "resumeWindow", "plausible", "note"],
        "properties": {
          "technology": { "type": "string" },
          "resumeWindow": { "type": "string" },
          "plausible": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "researchNotes": { "type": "array", "items": { "type": "string" } }
  }
}
