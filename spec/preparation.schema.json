{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preparation.schema.json",
  "type": "object",
  "required": ["version", "roleSummary", "points", "generalAnswers", "evaluation"],
  "properties": {
    "version": { "type": "string" },
    "roleSummary": { "$ref": "role-summary.schema.json" },
    "techLandscape": { "$ref": "tech-landscape.schema.json" },
    "points": { "type": "array", "minItems": 1, "items": { "$ref": "resume-point.schema.json" } },
    "generalAnswers": { "type": "array", "items": { "type": "object", "required": ["id", "question", "answer", "anchorPointIds"], "properties": { "id": { "type": "string" }, "question": { "type": "string" }, "answer": { "type": "string" }, "anchorPointIds": { "type": "array", "items": { "type": "string" } }, "ctar": { "type": "object" } } } },
    "evaluation": { "type": "object", "required": ["status", "checks"], "properties": { "status": { "enum": ["draft", "needs-review", "passed", "finalized"] }, "checks": { "type": "array", "items": { "type": "object", "required": ["id", "status", "detail"], "properties": { "id": { "type": "string" }, "status": { "enum": ["pass", "fail", "review"] }, "detail": { "type": "string" } } } } } }
  }
}
